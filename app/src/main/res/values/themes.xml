<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ShareMyLocation" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aurora_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        CropImageActivity (android-image-cropper) наследует AppCompatActivity: платформенная
        тема приложения ей не подходит, нужен AppCompat-родитель, причём с action bar —
        кнопку «Обрезать» библиотека рисует menu item'ом в системном action bar.
    -->
    <style name="Theme.ShareMyLocation.Cropper" parent="Theme.AppCompat.DayNight" />
</resources>
