rules_version = '2';

// Доступ к Firestore.
// users/{uid}: профиль читают все авторизованные (поиск по телефону, чтение профилей друзей);
// create/delete — только владельцу; update — владельцу без ограничений, чужому документу —
// только «добавить/удалить себя» в friendUids (self-only diff, см. isSelfFriendUidsChange).
// ОСТАТОЧНЫЙ РИСК (учесть в Фазе 4): правила не отличают легитимный self-add по
// ACCEPTED-заявке от прямой самозаписи в чужой friendUids (проверка потребовала бы
// getAfter() по friendRequests — признана избыточной для MVP). При проектировании шеринга
// нельзя доверять только факту нахождения в чужом friendUids — валидировать взаимность /
// наличие ACCEPTED-заявки в логике шеринга.
// avatars/{uid}: читают авторизованные, пишет только владелец.
// friendRequests/{requestId}: читают только участники; create — только отправитель
// (fromUid == auth.uid, toUid != auth.uid, status == 'PENDING', id = "{fromUid}_{toUid}");
// update — только получатель, только переход PENDING → ACCEPTED с запретом изменения
// fromUid, toUid, fromName, fromAvatarVersion; delete — любой участник.
// Снапшот fromName/fromAvatarVersion пишет сам отправитель (fromUid жёстко равен auth.uid);
// соответствие снапшота реальному профилю отправителя в правилах сознательно не проверяем.
// groups/{groupId}: личные «папки» владельца (ownerId) — пишет только владелец; чтение:
// владелец ИЛИ участник (memberUids; Фаза 7 — видимость шаринга по группам).
// ОСТАТОЧНЫЙ РИСК (Фаза 7): участник группы видит её имя и ПОЛНЫЙ memberUids — участники
// групп узнают о членстве (расплата за протухшие allowedGroupIds: без memberUids-проверки
// удалённый из группы оставался бы «видимым» навсегда). UI-путей к чужим группам нет —
// getGroup участник-не-владелец вызывает только проверка видимости карты.
// memberUids ⊆ friendUids владельца.
// ОСТАТОЧНЫЙ РИСК (унаследован из Фазы 3, учесть в Фазе 5): в friendUids возможна прямая
// самозапись (isSelfFriendUidsChange), поэтому шеринг не должен доверять только членству
// в memberUids — валидировать взаимную дружбу / наличие ACCEPTED-заявки в логике шеринга.
// sharingSettings/{uid}: настройки шаринга геолокации (Фаза 5). Владельческие БЕЗ resource.data:
// документ отсутствует до первого сохранения, а чтение перед первым сохранением обязано работать
// (урок Фаз 3–4: get несуществующего документа при правиле с resource.data даёт deny).
// Валидацию состава (allowedUids/allowedGroupIds) выполняет клиент при записи.
// Фаза 7: друг владельца читает настройки для вычисления видимости локации. Правило друга
// тоже БЕЗ resource: deny несуществующего документа = «не шарит» (семантика), клиент
// PERMISSION_DENIED (не друг) и NOT_FOUND (документа нет) трактует одинаково — «не шарит».
// Цена: каждое ЧУЖОЕ чтение настроек = 1 платное чтение правил (get users/{uid}).
// locations/{uid}: точка геолокации владельца (Фаза 6). Запись — только владельцу, БЕЗ
// resource.data (первый merge-set = create; состав полей не валидируем — консистентно
// с sharingSettings). Чтение разделено от записи: владелец или друг владельца.
// ОСТАТОЧНЫЙ РИСК (унаследован из Фазы 3, учесть в Фазе 7): самозапись в чужой friendUids
// доходит и до правила чтения locations — при показе чужой локации перевалидировать взаимную
// дружбу / наличие ACCEPTED-заявки. Каждое ЧУЖОЕ чтение локации = 1 платное чтение правил
// (get users/{uid}) — на квоты Фазы 7.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner(uid);
      // Свой документ — без ограничений; чужой — только «добавить/удалить себя» в friendUids.
      allow update: if isOwner(uid) || isSelfFriendUidsChange();
    }

    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    match /friendRequests/{requestId} {
      // get по несуществующему документу безопасен: resource не читаем, только id, —
      // клиентская проверка «заявки нет» не падает с PERMISSION_DENIED.
      allow get: if request.auth != null && isRequestParticipantById(requestId);

      allow list: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'PENDING'
        // id обязан совпадать с парой участников — иначе get-по-id давал бы
        // доступ к документам с «чужими» идентификаторами.
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid;

      // update — только получателем, только переход PENDING → ACCEPTED,
      // снапшот-поля (fromUid, toUid, fromName, fromAvatarVersion) неизменны.
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'ACCEPTED'
        && resource.data.fromUid == request.resource.data.fromUid
        && resource.data.toUid == request.resource.data.toUid
        && resource.data.fromName == request.resource.data.fromName
        && resource.data.fromAvatarVersion == request.resource.data.fromAvatarVersion;

      // delete — любой участник (resource-based).
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /groups/{groupId} {
      // Группа — личная «папка» владельца. Правила читают resource.data, поэтому:
      // list обязан фильтровать запрос по ownerId (realtime-список групп владельца);
      // get несуществующего документа = deny — клиент трактует это как «группа не найдена»
      // (осознанное следствие урока Фазы 3).
      // Фаза 7: get разрешён и участнику (memberUids) — проверка видимости шаринга по группам;
      // разбор OR-правила сломал бы провержимость list-запроса, поэтому get и list разделены.
      allow get: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.get('memberUids', []));

      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // create — только будущий владелец; имя и состав — те же ограничения, что и при update.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isGroupName(request.resource.data.name)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 100
        && isOwnedMembers(request.auth.uid, request.resource.data.memberUids);

      // update — только владельцем: ownerId и createdAt неизменны, меняются только
      // name/memberUids/updatedAt; имя и состав проходят те же проверки, что и при create.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'memberUids', 'updatedAt'])
        && isGroupName(request.resource.data.name)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 100
        && isOwnedMembers(resource.data.ownerId, request.resource.data.memberUids);

      // delete — только владельцем (resource-based; несуществующий документ = deny,
      // клиент удаляет только id из realtime-списка).
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /sharingSettings/{uid} {
      // Настройки шаринга геолокации — владельческие БЕЗ resource.data: документ отсутствует
      // до первого сохранения, а чтение перед первым сохранением обязано работать
      // (урок Фаз 3–4: get несуществующего документа при правиле с resource.data даёт deny).
      // Состав списков валидирует клиент при записи.
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Фаза 7: друг владельца читает настройки, чтобы вычислить видимость его локации.
      // resource НЕ читаем намеренно: deny несуществующего документа = «не шарит» (семантика);
      // клиент PERMISSION_DENIED (не друг) и NOT_FOUND (документа нет) трактует одинаково.
      // Цена: 1 get правил (users/{ownerId}) на каждое чужое чтение настроек.
      allow read: if request.auth != null
        && request.auth.uid != uid
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('friendUids', []);
    }

    match /locations/{uid} {
      // Точка геолокации владельца (Фаза 6). Запись владельческая БЕЗ resource.data:
      // первый merge-set = create, правило без resource пускает и create, и update;
      // состав полей (geo/accuracy/updatedAt) не валидируем — консистентно с sharingSettings.
      allow write: if request.auth != null && request.auth.uid == uid;

      // Чтение разделено от записи: владелец или друг владельца (п. «Чтение локаций» Фазы 7).
      // ВАЖНО: каждое ЧУЖОЕ чтение локации = 1 платное чтение правил (get users/{uid});
      // самозапись в чужой friendUids проходит сюда — Фаза 7 обязана перевалидировать
      // взаимность при показе (см. шапку).
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('friendUids', []));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Имя группы: непустая после trim строка длиной ≤ 50 символов
    // (лимит дублирует константу интерактора MAX_GROUP_NAME_LENGTH).
    function isGroupName(name) {
      return name is string && name.trim().size() > 0 && name.size() <= 50;
    }

    // Состав группы ⊆ friendUids владельца (пустой состав проходит): group нельзя указать
    // произвольного uid, не являющегося другом. Читает users/{ownerId} — владелец всегда
    // имеет право на чтение своего документа.
    function isOwnedMembers(ownerId, memberUids) {
      return memberUids.toSet()
        .difference(
          get(/databases/$(database)/documents/users/$(ownerId))
            .data.get('friendUids', []).toSet()
        )
        .size() == 0;
    }

    // Чужой users-документ допустимо менять только в рамках операций дружбы:
    // затронуты только friendUids/updatedAt, а разница списков — ровно добавление
    // или ровно удаление самого request.auth.uid (ничего больше).
    function isSelfFriendUidsChange() {
      let oldUids = resource.data.get('friendUids', []).toSet();
      let newUids = request.resource.data.get('friendUids', []).toSet();
      let added = newUids.difference(oldUids);
      let removed = oldUids.difference(newUids);
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['friendUids', 'updatedAt'])
        && (
          (added.hasOnly([request.auth.uid]) && removed.size() == 0)
          || (removed.hasOnly([request.auth.uid]) && added.size() == 0)
        );
    }

    // Участник заявки определяется разбором id "{fromUid}_{toUid}", поэтому get работает
    // и для несуществующего документа: resource не читается, только идентификатор.
    function isRequestParticipantById(requestId) {
      let parts = requestId.split('_');
      return parts.size() == 2
        && (parts[0] == request.auth.uid || parts[1] == request.auth.uid);
    }
  }
}
